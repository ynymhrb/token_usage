{
  "mcpServers": {
    "context_optimizer": {
      "command": "py",
      "args": [
        "-3",
        "scripts/mcp_server.py"
      ],
      "cwd": ".",
      "enabled": true,
      "env_vars": ["CODEX_HOME", "PATH"],
      "default_tools_approval_mode": "prompt"
    },
    "token_analyzer": {
      "command": "py",
      "args": [
        "-3",
        "scripts/token_analyzer_server.py"
      ],
      "cwd": ".",
      "enabled": true,
      "env_vars": ["CODEX_HOME", "PATH"],
      "default_tools_approval_mode": "approve"
    }
  }
}
