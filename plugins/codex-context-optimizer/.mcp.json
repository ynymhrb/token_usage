{
  "mcpServers": {
    "context_optimizer": {
      "command": "python",
      "args": [
        "scripts/mcp_server.py"
      ],
      "cwd": ".",
      "enabled": false,
      "env_vars": [
        "CODEX_HOME",
        "PATH"
      ],
      "default_tools_approval_mode": "prompt"
    },
    "token_analyzer": {
      "command": "python",
      "args": [
        "scripts/token_analyzer_server.py"
      ],
      "cwd": ".",
      "enabled": true,
      "default_tools_approval_mode": "approve"
    }
  }
}
